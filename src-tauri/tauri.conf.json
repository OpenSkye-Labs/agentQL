{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentQL",
  "version": "0.1.0",
  "identifier": "com.aindong.agentql",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentQL",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMjFEOUU2MjQ4Rjg3RUMKUldUc2g0OGs1dGtoc3JDQ2srUHV4cHQ3em5yK0RmL3lUb3lpbHBVdUFQNnJkK2hIRHk4bGJtdy8K",
      "endpoints": [
        "https://github.com/OpenSkye-Labs/agentQL/releases/latest/download/latest.json"
      ]
    }
  }
}
